-- Intermediate SQL Queries --

-- Display products with their category names -- 
SELECT
    p.id,
    p.name AS product_name,
    p.price,
    c.name AS category_name
FROM products p
JOIN categories c
    ON p.category_id = c.id;

-- Display users and their addresses --
SELECT
    u.id,
    u.name,
    u.email,
    a.address_line,
    a.city,
    a.state
FROM users u
JOIN addresses a
    ON u.id = a.user_id;

-- Display orders with customer names --
SELECT
    o.id AS order_id,
    u.name AS customer_name,
    o.order_date,
    o.status,
    o.total_amount
FROM orders o
JOIN users u
    ON o.user_id = u.id;

-- Find the number of products in each category --
SELECT
    c.id,
    c.name AS category_name,
    COUNT(p.id) AS product_count
FROM categories c
LEFT JOIN products p
    ON c.id = p.category_id
GROUP BY c.id, c.name;

-- Find the average product price in each category --
SELECT
    c.name AS category_name,
    AVG(p.price) AS average_price
FROM categories c
JOIN products p
    ON c.id = p.category_id
GROUP BY c.id, c.name;

-- Find categories having more than 5 products -- 
SELECT
    c.name,
    COUNT(p.id) AS product_count
FROM categories c
JOIN products p
    ON c.id = p.category_id
GROUP BY c.id, c.name
HAVING COUNT(p.id) > 5;

-- Display cart items with product details --
SELECT
    ci.cart_id,
    p.name AS product_name,
    p.price,
    ci.quantity,
    p.price * ci.quantity AS item_total
FROM cart_items ci
JOIN products p
    ON ci.product_id = p.id;

-- Calculate the total value of each cart --
SELECT
    c.id AS cart_id,
    c.user_id,
    SUM(p.price * ci.quantity) AS cart_total
FROM cart c
JOIN cart_items ci
    ON c.id = ci.cart_id
JOIN products p
    ON ci.product_id = p.id
GROUP BY c.id, c.user_id;

-- Find users who have placed at least one order --
SELECT DISTINCT
    u.id,
    u.name,
    u.email
FROM users u
JOIN orders o
    ON u.id = o.user_id;

--  Find products priced above the average product price --
SELECT *
FROM products
WHERE price > (
    SELECT AVG(price)
    FROM products
);









